[Unit]
Description=TYBot 첨부 변환 재처리 큐 비우기 (B-45)
Documentation=file:///opt/tybot/docs/deploy/rocky8.md
After=network-online.target

[Service]
Type=oneshot
User=tybot
Group=tybot
WorkingDirectory=/opt/tybot
Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8
Environment=TYBOT_ENV_FILE=/etc/tybot/tybot.env
ExecStart=/opt/tybot/.venv/bin/python scripts/drain_conversion_queue.py --apply --limit 20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tybot-convert-retry
# 변환기 자체 상한(120초) × 처리 건수보다 넉넉해야 한다. 여기서 끊기면 잡아 둔
# 임대가 만료될 때까지 그 작업이 멈춘다.
TimeoutStartSec=1800

# 검증된 추출 결과는 기존 원문 줄을 고치지 않고 새 첨부 추출 줄로 추가한 뒤
# 검색 색인을 갱신한다. 따라서 staging 과 archive 에 쓰기 권한이 모두 필요하다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tybot/staging /var/lib/tybot/archive
ReadOnlyPaths=/var/lib/tybot/objects
