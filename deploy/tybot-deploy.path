[Unit]
Description=TYBot 배포 요청 감시 (관리 콘솔 -> root 배포)
Documentation=file:///opt/tybot/docs/deploy/rocky8.md

[Path]
# 콘솔(User=tybot)이 이 파일을 만들면 아래 서비스가 root 로 배포를 수행한다.
# 파일 '존재'만 신호로 쓴다 - 내용은 감사기록용이고 명령 인자로 쓰이지 않는다.
PathExists=/var/lib/tybot/deploy-request.json
Unit=tybot-deploy.service

[Install]
WantedBy=paths.target
