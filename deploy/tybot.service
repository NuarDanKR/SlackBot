[Unit]
Description=TYBot — Slack AI 아카이브 봇 (Socket Mode, 아웃바운드 전용)
Documentation=file:///opt/tybot/docs/deploy/rocky8.md
# postgresql 은 인덱서 도입 단계에서 사용. 미설치 상태여도 무해하다.
After=network-online.target postgresql-16.service
Wants=network-online.target
# 재시작 폭주 차단 - 이 두 지시자는 [Unit] 섹션이다([Service] 에 두면 무시되고 경고만 뜬다).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tybot
Group=tybot
WorkingDirectory=/opt/tybot

# 로그 즉시 flush(journald 지연 방지) + 한글 출력 안전
Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8

# 시크릿·설정은 /etc/tybot/tybot.env (0640 root:tybot).
# EnvironmentFile= 을 쓰지 않는 이유: systemd 파서는 `export VAR=`, `VAR = `(공백),
# 인라인 주석을 무시하거나 값에 포함시킨다. 앱이 python-dotenv 로 직접 읽으면
# 그 계열의 어긋남(점검은 통과, 기동은 실패)이 사라진다.
# 값을 임시로 덮어쓸 때는 drop-in 에 Environment= 를 쓰면 파일보다 우선한다.
Environment=TYBOT_ENV_FILE=/etc/tybot/tybot.env
ExecStart=/opt/tybot/.venv/bin/python -m tybot.slack.pilot

# 봇은 반드시 단일 인스턴스. systemd 가 중복 기동을 막는다(중복 답변·비용 2배 방지).
Restart=always
RestartSec=10

# 로그는 journald 로 (파일 로테이션 불필요)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tybot

# --- 샌드박싱 ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
# 쓰기 허용 경로 — 아카이브와 캐시만
ReadWritePaths=/var/lib/tybot
# 인바운드 소켓 불필요(Socket Mode 는 아웃바운드 WebSocket)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
