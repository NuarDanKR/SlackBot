[Unit]
Description=Refresh the PF Hermes channel privacy manifest
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/tybot/tybot.env
ConditionPathExists=/etc/hermes-pf/privacy.env
ConditionPathIsDirectory=/etc/hermes-pf

[Service]
Type=oneshot
User=tybot
Group=tybot
Environment=TYBOT_ENV_FILE=/etc/tybot/tybot.env
Environment=PYTHONPATH=/opt/tybot/src
Environment=LANG=C.UTF-8
EnvironmentFile=/etc/hermes-pf/privacy.env

# The query runs as tybot. Only the two install steps regain root privileges;
# the first writes beside the target and the second atomically replaces it.
ExecStart=/opt/tybot/.venv/bin/python -m tybot.archive.privacy_manifest --workspace ${HERMES_PRIVACY_WORKSPACE} --out /var/lib/tybot/state/hermes-pf-privacy.json
ExecStartPost=+/usr/bin/install -o root -g hermes -m 0640 /var/lib/tybot/state/hermes-pf-privacy.json /etc/hermes-pf/.privacy-manifest.json.new
ExecStartPost=+/usr/bin/mv -f /etc/hermes-pf/.privacy-manifest.json.new /etc/hermes-pf/privacy-manifest.json

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tybot/state /etc/hermes-pf
InaccessiblePaths=-/var/lib/tybot/archive -/var/lib/tybot/archiver-shadow -/var/lib/tybot/qa-log
