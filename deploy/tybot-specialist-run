#!/usr/bin/env bash
# 전문 봇 컨테이너 기동 helper — 허용 목록에 있는 동작만 한다.
#
# 설계: docs/design/specialist-runtime-v2.md §런타임 격리
#
#   tybot-specialist-run precheck <key>
#   tybot-specialist-run start    <key>
#   tybot-specialist-run stop     <key>
#
# ## 왜 인자를 이렇게 좁히나
#
# 콘솔 사용자에게 Podman 권한도, root shell 도, 임의 systemd unit 작성 권한도
# 주지 않는다. 콘솔은 DB 에 작업을 요청할 뿐이고, 고정된 이 helper 가 **허용 목록에
# 있는 동작만** 수행한다. 그래서 여기서 받는 것은 동작 이름과 전문가 key 뿐이다 —
# 이미지·포트·마운트·환경변수를 인자로 받으면, 그 인자를 넣을 수 있는 사람이
# 곧 root 로 임의 컨테이너를 띄울 수 있는 사람이 된다.
#
# 이미지 digest 는 인자가 아니라 **drop-in 파일**로 온다. 배포 helper 가 그
# 파일을 쓰고 systemd 가 읽는다.
set -euo pipefail

ACTION=${1:-}
KEY=${2:-}

RUN_DIR=/run/tybot-subbots
STATE_DIR=/var/lib/tybot-subbots
PODMAN=/usr/bin/podman

die() { echo "tybot-specialist-run: $*" >&2; exit 1; }

# key 는 컨테이너 이름·소켓 경로·사용자 이름에 모두 들어간다. 한 곳이라도
# 새면 나머지가 다 열린다.
[[ "$KEY" =~ ^[a-z][a-z0-9-]{1,31}$ ]] || die "전문가 key 형식이 올바르지 않습니다"
# 인자를 셋 이상 받지 않는다. 늘리는 순간 이 helper 가 범용 실행기가 된다.
[[ $# -eq 2 ]] || die "인자는 <동작> <key> 둘뿐입니다"

CONTAINER="tybot-specialist-$KEY"
SOCKET_DIR="$RUN_DIR/$KEY"

case "$ACTION" in
precheck)
  # 이미지가 **digest 로** 고정돼 있어야 한다. 태그면 기동하지 않는다 —
  # 태그는 움직이고, 움직이는 것을 승인하면 승인한 것과 도는 것이 갈린다.
  IMAGE=${TYBOT_SPECIALIST_IMAGE:-}
  [[ -n "$IMAGE" ]] || die "배포된 이미지가 없습니다 (drop-in 미설정)"
  [[ "$IMAGE" =~ ^localhost/tybot-specialist/${KEY}@sha256:[0-9a-f]{64}$ ]] \
    || die "이미지는 이 전문가의 sha256 digest 여야 합니다"
  command -v "$PODMAN" >/dev/null || die "podman 이 없습니다"
  [[ -s "${CREDENTIALS_DIRECTORY:-}/hmac" ]] || die "HMAC 자격이 주입되지 않았습니다"
  # 남아 있는 소켓은 지운다. 남으면 죽은 컨테이너의 소켓에 계속 연결을 시도한다.
  rm -f "$SOCKET_DIR/http.sock"
  install -d -m 0750 "$STATE_DIR/$KEY"
  ;;

start)
  IMAGE=${TYBOT_SPECIALIST_IMAGE:-}
  [[ "$IMAGE" =~ ^localhost/tybot-specialist/${KEY}@sha256:[0-9a-f]{64}$ ]] \
    || die "이미지 digest 가 올바르지 않습니다"

  # 프로필별 네트워크. **기본은 차단**이고, allowlist 를 실제로 강제할 수단이
  # 준비되지 않으면 열지 않는다(설계 §런타임 격리). 단순 DNS 이름 확인만으로는
  # 우회 가능하므로, 강제 수단은 방화벽/프록시 쪽에 있어야 한다.
  NETWORK_ARGS=(--network=none)
  if [[ -f "$STATE_DIR/$KEY/network-profile" ]]; then
    PROFILE=$(<"$STATE_DIR/$KEY/network-profile")
    case "$PROFILE" in
    none) ;;
    anthropic-only)
      [[ -n "${TYBOT_EGRESS_NETWORK:-}" ]] \
        || die "egress allowlist 네트워크가 없어 anthropic-only 를 켤 수 없습니다"
      NETWORK_ARGS=(--network="$TYBOT_EGRESS_NETWORK")
      ;;
    *) die "알 수 없는 network_profile: $PROFILE" ;;
    esac
  fi

  exec "$PODMAN" run \
    --rm \
    --name "$CONTAINER" \
    --sdnotify=conmon \
    --replace \
    "${NETWORK_ARGS[@]}" \
    --read-only \
    --read-only-tmpfs \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m \
    --security-opt=no-new-privileges \
    --cap-drop=ALL \
    --pids-limit=128 \
    --cpus=1 \
    --memory=512m \
    --memory-swap=512m \
    --userns=keep-id \
    --user 10001:10001 \
    --ipc=private \
    --pid=private \
    --volume "$SOCKET_DIR:/run/specialist:rw,noexec,nosuid,nodev" \
    --volume "${CREDENTIALS_DIRECTORY}/hmac:/run/secrets/hmac:ro,noexec,nosuid,nodev" \
    --env TYBOT_SOCKET=/run/specialist/http.sock \
    --env TYBOT_HMAC_FILE=/run/secrets/hmac \
    "$IMAGE"
  ;;

stop)
  "$PODMAN" rm -f -i "$CONTAINER" >/dev/null 2>&1 || true
  rm -f "$SOCKET_DIR/http.sock"
  ;;

*)
  die "허용된 동작은 precheck|start|stop 뿐입니다"
  ;;
esac
