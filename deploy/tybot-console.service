[Unit]
Description=TYBot 관리 콘솔 (조회 + 제한된 환경설정)
Documentation=file:///opt/tybot/docs/design/console.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tybot
Group=tybot
WorkingDirectory=/opt/tybot

# 설정은 봇과 같은 파일을 읽는다(아카이브·감사기록 경로가 같아야 하므로).
# 콘솔 전용 값(CONSOLE_USERS 등)도 같은 파일에 둔다.
EnvironmentFile=/etc/tybot/tybot.env

# 사내망 전체에 연다(오너 승인 2026-09-01).
#
# **이 구성은 평문 HTTP 다. 임시 상태이며 nginx + TLS 로 옮긴다(BACKLOG B-35).**
# 지금은 로그인 비밀번호와 세션 쿠키가 사내망을 그대로 지나간다. 이 화면은
# 아카이브 원문 열람·환경설정 변경·배포 승인을 쥐고 있으므로 오래 둘 상태가 아니다.
#
# 함께 지켜야 하는 것:
#   - 임시 계정 admin/1111 을 반드시 제거한다(BACKLOG B-20). 안 그러면 사내 누구나 들어온다
#   - 방화벽에서 8787 출발지를 필요한 대역으로 좁힌다
#   - TLS 를 붙이면 CONSOLE_COOKIE_SECURE=1 을 켠다(그 전에 켜면 로그인이 안 된다)
ExecStart=/opt/tybot/.venv/bin/uvicorn tybot.console.app:app \
    --host 0.0.0.0 --port 8787 --app-dir /opt/tybot/src

Restart=on-failure
RestartSec=5s

# 콘솔은 봇을 재기동할 수 있어야 하지만, 그 외 권한은 갖지 않는다.
# 재기동 기능을 켤 때 아래 sudoers 한 줄만 추가한다:
#   tybot ALL=(root) NOPASSWD: /usr/bin/systemctl restart tybot.service
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/tybot

[Install]
WantedBy=multi-user.target
