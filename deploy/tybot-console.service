[Unit]
Description=TYBot 관리 콘솔 (조회 + 제한된 환경설정)
Documentation=file:///opt/tybot/docs/design/console.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tybot
Group=tybot
WorkingDirectory=/opt/tybot

# 설정은 봇과 같은 파일을 읽는다(아카이브·감사기록 경로가 같아야 하므로).
# 콘솔 전용 값(CONSOLE_USERS 등)도 같은 파일에 둔다.
EnvironmentFile=/etc/tybot/tybot.env

# 루프백에만 연다 (B-35, 2026-09-22).
#
# 2026-09-01 부터 `--host 0.0.0.0` 로 사내망 전체에 평문으로 열려 있었다. 로그인
# 비밀번호와 세션 쿠키가 매 요청 사내망을 그대로 지나갔고, 이 화면은 아카이브 원문
# 열람·환경설정 변경·배포 승인을 쥐고 있다. 임시 상태로 두기로 한 것이었고 이것이
# 그 약속을 끝내는 변경이다.
#
# 밖으로 나가는 문은 이제 nginx 하나다 — `deploy/nginx/tybot-console.conf` 가
# 443 에서 TLS 를 끝내고 여기로 넘긴다.
#
# 순서가 있다:
#   1. nginx 배치 → `nginx -t` → reload
#   2. 이 unit 재시작 (루프백 바인딩)
#   3. 방화벽에서 8787 을 막는다
#   4. **그다음에** CONSOLE_COOKIE_SECURE=1 을 켜고 재시작
#
# 4번을 먼저 하면 브라우저가 쿠키를 보내지 않아 로그인이 안 되고, 화면에는
# 「비밀번호가 틀렸다」 처럼 보인다.
ExecStart=/opt/tybot/.venv/bin/uvicorn tybot.console.app:app \
    --host 127.0.0.1 --port 8787 --app-dir /opt/tybot/src

Restart=on-failure
RestartSec=5s

# 서비스 로그는 설치 시 배치되는 고정 헬퍼만 sudo로 읽는다. 전체 journal 그룹 권한이나
# 임의 systemctl 권한은 주지 않는다.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/tybot

[Install]
WantedBy=multi-user.target
