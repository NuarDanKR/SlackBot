[Unit]
Description=TYBot Archiver image description worker for %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=tybot
Group=tybot
WorkingDirectory=/opt/tybot
Environment=TYBOT_ENV_FILE=/etc/tybot/archiver.env
Environment=STATE_DIR=/var/lib/tybot
EnvironmentFile=/etc/tybot/archiver.env
# Rocky 8의 systemd 239에는 LoadCredential=이 없다. 값이 아니라 0600 파일
# 경로만 넘기며 resolver가 권한과 내용을 검사한다.
Environment=TYBOT_VISION_DATABASE_URL_FILE=/etc/tybot/tybot-vision-database-url
# Vision provider 자격 **전용** 키. 워크스페이스 Slack 토큰 키는 이 worker 에 주지 않는다
# (2026-11-12 보안 리뷰). 0400 tybot 소유 파일이며 install.sh 가 없을 때만 만든다.
Environment=VISION_PROVIDER_SECRET_KEY_FILE=/etc/tybot/vision-provider-secret.key
# archiver.env 는 수집기와 같이 쓰는 파일이라 워크스페이스 토큰 키·Master DB 접속이 들어 있다
# (2026-11-12 서버 실측). worker 에는 둘 다 필요 없으므로 환경에서 지우고, 키 파일 자체도
# 이 프로세스에서는 보이지 않게 한다 — 같은 tybot 계정이라 파일 권한으로는 못 막는다.
UnsetEnvironment=WORKSPACE_SECRET_KEY_FILE WORKSPACE_SECRET_KEY DATABASE_URL PGPASSFILE
InaccessiblePaths=-/etc/tybot/workspace-secret.key
ExecStart=/opt/tybot/.venv/bin/python -m tybot.archive.image_description_job --workspace %i
TimeoutStartSec=900
TimeoutStopSec=30
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tybot-image-description-%i
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
ReadOnlyPaths=/var/lib/tybot/archive
ReadWritePaths=/var/lib/tybot/image-description /var/lib/tybot/image-description-notify

