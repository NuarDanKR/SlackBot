[Unit]
Description=TYBot 일정 스냅샷 반영 (inbox -> PostgreSQL)
Documentation=file:///opt/tybot/docs/design/schedule-command.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tybot
Group=tybot
WorkingDirectory=/opt/tybot
# 방식 A(봇 서버가 Oracle 을 직접 조회)라 **추출도 여기서 한다.**
# 예전에는 받는 쪽만 돌아서 inbox 가 늘 비어 있었고, 로그에는
# '반영할 스냅샷이 없다' 만 남아 고장으로 보이지 않았다.
ExecStart=/opt/tybot/.venv/bin/python /opt/tybot/scripts/schedule_export.py \
    --out /var/lib/tybot/inbox-schedule --mode live --horizon-hours 48
ExecStart=/opt/tybot/.venv/bin/python -m tybot.schedulesync
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tybot-schedule-sync
# 반영은 트랜잭션 하나다. 오래 걸리면 스냅샷이 밀린 것이므로 다음 실행에 맡긴다.
TimeoutStartSec=180
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/tybot
