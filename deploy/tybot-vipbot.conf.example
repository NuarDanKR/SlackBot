# VIPBot 전용 설정. 서버에서는 /etc/tybot/tybot-vipbot.conf 로 둔다.
#
#   sudo install -o root -g tybot -m 0640 \
#       /opt/tybot/deploy/tybot-vipbot.conf.example /etc/tybot/tybot-vipbot.conf
#   sudo vi /etc/tybot/tybot-vipbot.conf
#
# ## 여기 들어갈 수 있는 것은 네 키뿐이다
#
# systemd 의 `EnvironmentFile=` 은 이 파일의 **모든 줄**을 환경변수로 만든다.
# 그래서 이 파일은 「VIPBot 설정」 이 아니라 **「VIPBot 프로세스의 환경 전체」**
# 다. 아무 키나 적으면 그 값이 프로세스에 들어가고, `DATABASE_URL` 한 줄이면
# 전용 DB 계정을 만든 의미가 사라진다.
#
# 시크릿은 **절대 여기 적지 않는다.** DSN·Slack 토큰·API 키는 systemd
# 자격증명 파일로만 들어온다. systemd 239 유닛에는 값이 아니라 파일 경로만
# 멎으면 사라지고, 이 파일을 읽을 수 있는 사람에게 보이지 않는다.
#
# 준비 점검이 켜기 전에 되검사한다:
#   sudo -u tybot /opt/tybot/.venv/bin/python \
#       /opt/tybot/scripts/check_vipbot_readiness.py
# 빠진 키는 `settings_key_missing`, 모르는 키는 `settings_key_forbidden` 으로
# **이름만** 보고한다. 값은 출력하지 않는다.

# 필수 — Slack 워크스페이스 키(소문자·숫자·하이픈)
VIPBOT_WORKSPACE=

# 필수 — 아카이브 뿌리. **절대경로**여야 한다. 상대경로는 기동 디렉터리에 따라
# 다른 아카이브를 열고, 그 차이는 답변 범위가 달라지는 것으로만 드러난다.
VIPBOT_ARCHIVE_DIR=/var/lib/tybot/archive

# 필수 — 하루 모델 비용 상한(USD). TYBot 예산과 나눠 쓰지 않는다.
# `0`·음수·`1_0`·`+10`·`.5` 는 거절된다.
VIPBOT_DAILY_LIMIT_USD=5.00

# 선택 — 비워 두면 승인된 기본 모델을 쓴다. 다른 값을 적으면 기동이 거절된다.
#VIPBOT_MODEL=claude-opus-5-5
