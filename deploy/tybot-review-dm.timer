[Unit]
Description=TYBot 검토자 하루치 DM 주기 실행

[Timer]
# B-88: one global round, including public holidays. The application repeats
# the KST weekday/time check and assigns a deterministic round ID.
OnCalendar=Tue *-*-* 17:00:00 Asia/Seoul
OnCalendar=Fri *-*-* 17:00:00 Asia/Seoul
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
