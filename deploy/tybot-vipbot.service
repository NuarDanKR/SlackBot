[Unit]
# B-83 VIPBot — TYBot 과 **다른 Slack 앱 · 다른 DB 계정**으로 도는 별도 프로세스.
#
# 이 유닛은 **준비 설치용 정적 유닛**이다. `[Install]` 섹션이 일부러 없어서
# `systemctl enable` 이 거부된다. readiness와 실제 Slack 운영 검증 전에 부팅에
# 걸어 두면 재시작을 반복하며 journal 만 채우고 「켜 두었다」 는 기억만 남는다.
# 가동할 때 아래 두 줄을 파일 끝에 더한다:
#     [Install]
#     WantedBy=multi-user.target
Description=VIPBot — 임원 전용 Slack 봇 (Socket Mode, 아웃바운드 전용)
After=network-online.target postgresql-16.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tybot
Group=tybot
WorkingDirectory=/opt/tybot

Environment=PYTHONUNBUFFERED=1
Environment=LANG=C.UTF-8

# --- 설정: 전용 파일 하나 -----------------------------------------------------
#
# 워크스페이스·아카이브 경로·일일 예산은 **여기 적지 않는다.** 유닛에 박으면
# 값을 바꿀 때마다 저장소를 고쳐 배포해야 하고, 서버마다 다른 값을 쓰는 순간
# 저장소의 유닛과 서버의 유닛이 갈린다. 그 갈림은 아무 데도 안 보인다.
#
# `/etc/tybot/tybot-vipbot.conf` 에는 **네 키만** 들어간다:
#   VIPBOT_WORKSPACE · VIPBOT_ARCHIVE_DIR · VIPBOT_DAILY_LIMIT_USD
#   VIPBOT_MODEL(선택)
# DSN·토큰·API 키 값은 **절대** 여기 넣지 않는다. systemd 239에서는 전용
# 0600 파일의 경로만 환경에 넣고, 런타임 해석기가 파일 모드와 내용을 검증한다.
# 들어온다. 준비 점검(`scripts/check_vipbot_readiness.py`)이 알 수 없는 키와
# 빠진 키를 켜기 전에 잡는다.
#
# `-` 접두를 쓰지 않는다. 파일이 없으면 **기동이 실패해야** 한다. 없는 채로
# 떠 버리면 `vipbot_workspace_unconfigured` 로 멎고, 원인이 journal 한 줄로만
# 남는다.
EnvironmentFile=/etc/tybot/tybot-vipbot.conf

# --- 시크릿: 자격증명으로만 넣는다 ------------------------------------------
#
# **`/etc/tybot/tybot.env` 를 읽지 않는다.** 그 파일에는 Master 의 `DATABASE_URL`
# 이 들어 있다. 이 프로세스가 그 값을 들고 있으면 전용 계정을 만든 의미가
# 사라진다 — VIPBot 코드 한 줄이면 모든 봇의 토큰 표를 열 수 있고, 그때
# `tybot_vipbot_runtime` 은 그냥 쓰이지 않는 역할이 된다.
#
# systemd 가 아래 셋을 0400 tybot 소유로 `$CREDENTIALS_DIRECTORY` 에 풀어 둔다.
# 디렉터리는 이 유닛의 프로세스만 볼 수 있고, 유닛이 멎으면 사라진다.
#
#   tybot-vipbot-database-url  — tybot.vipbot_dsn 이 CREDENTIALS_DIRECTORY 에서
#                                이 이름 그대로 찾는다. 환경변수로 넘기지 않는다
#   tybot-workspace-secret-key — 토큰 복호화 키(Fernet)
#   tybot-vipbot-anthropic-api-key — VIPBot 전용 모델 호출 자격증명
Environment=VIPBOT_DATABASE_URL_FILE=/etc/tybot/tybot-vipbot-database-url
Environment=WORKSPACE_SECRET_KEY_FILE=/etc/tybot/workspace-secret.key
Environment=VIPBOT_ANTHROPIC_API_KEY_FILE=/etc/tybot/tybot-vipbot-anthropic-api-key

# 배포가 런타임 모듈을 빠뜨렸다면 Slack 연결 전에 중단한다. ExecStartPre가
# 실패하면 유닛은 기동하지 않고 이유가 journal에 남는다.
ExecStartPre=/opt/tybot/.venv/bin/python -c "import tybot.vipbot_runtime"
ExecStart=/opt/tybot/.venv/bin/python -m tybot.vipbot_runtime

# 봇은 반드시 단일 인스턴스. systemd 가 중복 기동을 막는다(중복 답변·비용 2배).
Restart=always
RestartSec=10

MemoryHigh=1024M
MemoryMax=1536M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tybot-vipbot

# --- 샌드박싱 ---------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
# 아카이브는 **읽기만** 한다. VIPBot 은 수집·백필·첨부 보관 주체가 아니다(B-83).
ReadOnlyPaths=/var/lib/tybot/archive
RuntimeDirectory=tybot-vipbot
RuntimeDirectoryMode=0750
StateDirectory=tybot-vipbot
StateDirectoryMode=0750
ReadWritePaths=/run/tybot-vipbot
# 인바운드 소켓 불필요(Socket Mode 는 아웃바운드 WebSocket).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# [Install] 없음 — 위 머리말 참고.
