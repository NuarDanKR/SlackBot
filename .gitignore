# 시크릿 — 절대 커밋 금지
.env
*.env
!.env.example
secrets/
*credentials*
*_token*
service-account*.json

# 개인정보 / 아카이브 제외 대상
**/등기부*
**/계약자명단*

# 파이썬
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 로컬 아카이브 원문 — 사내 대화. 코드 저장소에 커밋 금지(중앙 아카이브는 별도 저장소)
/archive/
/staging/
/objects/
/derived/
/qa-log/

# 콘솔에서 내려받은 답변 문제 패킷. **사내 질문·답변과 피드백 원문이 들어 있다.**
# 고치는 동안만 로컬에 두고, 저장소에는 올리지 않는다 — 한 번 올라가면 이력에서
# 지우기 어렵고, 그 이력은 저장소를 받는 모든 사람에게 따라간다.
/qa-issues/

# 빌드 산물
*.egg-info/

# 관리 콘솔 프론트엔드
console-web/node_modules/
console-web/dist/
# PF 콘솔(`/pf/`) 빌드 산출물. 같은 소스에서 따로 만든다.
console-web/dist-pf/
# tsc 증분 빌드 캐시. 추적하면 빌드할 때마다 뜻 없는 변경이 생기고,
# 배포 커밋에 섞여 실제 변경을 가린다. 지워도 다시 만들어진다.
console-web/tsconfig.tsbuildinfo
# 스크린샷·브라우저 자동화 산출물
.playwright-mcp/

# 참고용으로 내려받은 남의 저장소. 커밋하지 않는다 —
# 낡은 사본이 남고, 그쪽 비공개 채널명·사업장명이 우리 저장소로 새어 들어온다.
# 가져올 것은 코드가 아니라 판정 규칙이고, 그건 docs/design/ 에 옮겨 적는다.
ref/

# 프금팀이 전달한 Hermes 소스 스냅샷. `ref/` 와 같은 이유로 커밋하지 않는다 —
# 소유자가 프금팀이고, 우리 저장소에 두면 낡은 사본이 정본처럼 남는다.
# 폴더명의 `1.2` 는 구별용으로 우리가 붙인 것이고 공식 버전명이 아니다
# (docs/design/pf-hermes-owner-plan.md 「명칭」).
#
# 우리가 가져오는 것은 코드가 아니라 **검증된 검색 행동**이고, 그것은 TYBot 의
# 권한·근거 모델 위에 다시 구현한다(같은 문서 §1). 정본 판정은 docs/design/ 에 적는다.
subbots/hermes_v1.2/
