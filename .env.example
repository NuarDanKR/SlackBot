# TYBot 부트스트랩·비상 대체 환경변수 예시 (실제 값은 저장소에 커밋 금지)
#
# 주의: 값 뒤에 인라인 주석을 쓰지 않는다. 설명은 줄 앞에 단독으로 둔다.
#       `VAR=값  # 설명` 형태는 파서에 따라 주석까지 값에 섞여 설정 오류가 된다.

# --- Slack: 멀티 워크스페이스 ---
# 자세한 절차: docs/multi-workspace.md
# 키(pilot, mgmt)는 환경변수 접미사·아카이브 디렉터리·프론트매터에 함께 쓰인다.
# 소문자 ASCII 로 짧게 정하고, 수집을 시작한 뒤에는 바꾸지 않는다.
# 크로스 워크스페이스 열람 화이트리스트. 비워두면 완전 격리(기본값).
# 형식은 '읽는쪽:대상1|대상2' 이고 단방향이다. 값에는 라벨이 아니라 키를 쓴다.
# 화이트리스트는 '넘어갈 수 있는 후보'만 정한다(관문 2개).
# 실제로 무엇이 넘어가는지는 아래 ROOT_WORKSPACES 여부로 갈린다:
#   - root 워크스페이스가 읽을 때: 대상 워크스페이스 자료 전량
#   - 등위(peer) 워크스페이스가 읽을 때: 문서 프론트매터의 share_with 에 명시된 것만
# visibility: public 은 자기 워크스페이스 안에서 채널 멤버십만 면제한다(크로스와 무관).
# 상위(root) 워크스페이스. 산하 자료를 문서 표시와 무관하게 열람하고,
# 자기 워크스페이스 안에서 채널 멤버십 필터를 받지 않는다(경영본부 등 취합·열람 조직).
# 등위 워크스페이스끼리는 root 가 아니므로, 문서 프론트매터의 share_with 로만 넘어간다.

# 워크스페이스와 Slack 토큰은 관리 콘솔의 '워크스페이스 관리'에서 DB에 저장한다.
# 아래 공통 봇 동작만 환경설정 오버레이로 관리한다.
REPLY_IN_THREAD=1

# DB 장애 때도 Slack 연결을 유지해야 하는 운영 환경만 아래 비상 대체 설정을 사용한다.
# 평문 토큰이므로 DB 이전과 기동 검증이 끝난 뒤에는 두지 않는 것이 기본이다.
# WORKSPACES=pilot
# ROOT_WORKSPACES=
# CROSS_WS_READ=
# SLACK_BOT_TOKEN_PILOT=xoxb-REPLACE_ME
# SLACK_APP_TOKEN_PILOT=xapp-REPLACE_ME
# WORKSPACE_LABEL_PILOT=파일럿


# --- LLM 게이트웨이 ---
# 콘솔의 '환경변수 설정 → LLM API 키' 로 옮기는 편이 안전하다(암호화 저장).
# 여기 값은 DB 에 키가 없을 때만 쓰인다.
# ANTHROPIC_API_KEY=REPLACE_ME
# 모델 장애 때 순서대로 시도할 대체 모델(쉼표). **비어 있으면 폴백하지 않는다.**
# 어느 모델이 대체 가능한지는 정책이라 우리가 짐작하지 않는다.
# 폴백도 민감도 검사를 다시 통과해야 한다 — 급할 때만 조건이 느슨해지면 안 된다.
LLM_FALLBACK_MODELS=

# 전문 봇 라우팅에 쓸 저가 모델. 비면 claude-haiku-4-5.
# 라우팅은 분류다 — 답변 모델을 쓰면 질문마다 비용이 두 번 든다.
ROUTER_MODEL=
# OPENAI_API_KEY=REPLACE_ME
DEFAULT_MODEL=claude-sonnet-5
DAILY_COST_LIMIT_USD=10

# 당일 누적 사용액을 남기는 파일. 봇을 재시작해도 상한이 유지된다
# (없으면 재시작마다 0으로 리셋돼 상한이 사실상 사라진다).
# 기본값은 QA_LOG_DIR 아래 cost-state.json — 보통 지정할 필요가 없다.
# COST_STATE_PATH=/var/lib/tybot/qa-log/cost-state.json

# ==========================================================================
# ⚠️ 서버(운영)에 복사할 때는 아래 경로 3개를 반드시 절대경로로 바꾸세요.
#     ARCHIVE_DIR=/var/lib/tybot/archive
#     QA_LOG_DIR=/var/lib/tybot/qa-log
#     REPORTS_DIR=/var/lib/tybot/reports
#     STATE_DIR=/var/lib/tybot
# 이 파일의 기본값(./archive 등)은 **로컬 개발용**이다. 서비스는 상대경로를
# WorkingDirectory=/opt/tybot 기준으로 해석하는데 그 경로는 읽기 전용이라,
# 봇이 원문을 한 줄도 저장하지 못한 채 기동에 실패한다.
# 확인: scripts/check_env.py 의 '=== 쓰기 경로 ===' 절
# ==========================================================================

# --- 기본 설정 ---
# BOT_NAME 은 Slack 봇 핸들(ASCII). 안내 메시지의 /invite 대상에 쓰인다.
BOT_NAME=tybot
ARCHIVE_DIR=./archive
LOG_LEVEL=INFO

# 질의응답 감사 기록 (아카이브와 분리 - 봇 답변이 근거로 재사용되면 안 된다)
# QA_LOG_MD=1 이면 사람이 읽는 일자별 MD 도 함께 생성한다.
QA_LOG_DIR=./qa-log
QA_LOG_MD=1

# 실시간 수집: 봇이 참여했고 이름 규칙에 맞는 채널의 메시지만 들어오는 즉시 원문 저장
REALTIME_INGEST=1

# 채널 이름이 규칙(#두문자-조직명_조직코드-업무)에 맞으면 초대 없이 봇이 스스로 참여한다.
# 공개 채널만 가능하다 - 비공개는 Slack 설계상 사람이 초대해야 한다(scripts/invite_bot.py).
AUTOJOIN_CHANNELS=1

# 답변 위치. 1=스레드 답글(기본), 0=채널 본문에 바로 답변
REPLY_IN_THREAD=1

# 1 이면 아카이브에 쓸 수 없어도 기동한다(조회 전용). 기본 0 - 답변만 하면서
# 원문을 버리는 상태로 뜨는 것을 막는다. 운영에서 켜지 마세요.
ALLOW_READONLY_ARCHIVE=0

# 아카이브 점검(tybot-tidy.timer) 리포트 경로와 '수집 밀림' 판정 기준(일).
REPORTS_DIR=./reports
TIDY_STALE_DAYS=3

# 정기 백필(tybot-collect.timer) 의 채널 간 대기 초.
# Slack 신규 앱은 conversations.history 가 분당 1요청이라 60초 이상이어야 한다.
COLLECT_PACE_SECONDS=65

# 전 채널·전 워크스페이스 통합조회 허용자(Slack user id 콤마 구분).
# 채널 멤버십과 워크스페이스 경계를 모두 우회하므로 최소 인원만 등록한다.
EXEC_USERS=

# TYBot이 생성한 채널의 이름을 대신 변경할 수 있는 운영자(Slack user id 콤마 구분).
# 전 자료 열람 권한인 EXEC_USERS와 별개다. 비우면 최초 채널 생성 요청자만 변경 가능
CHANNEL_ADMIN_USERS=

# 채널 생성을 본인 소속(과 상위) 조직으로 제한한다. 남의 팀 채널을 만들면
# 그 채널의 주인이 처음부터 어긋난다. CHANNEL_ADMIN_USERS 는 예외다.
CHANNEL_ORG_SCOPE=1
# 신원 매핑(user_identity)이 없는 사람도 막을지. 기본 0 — 매핑 작업이 끝나기
# 전에 채널 생성이 통째로 멈추면 안 된다. 매핑이 끝나면 1 로 올린다.
CHANNEL_ORG_SCOPE_STRICT=0

# --- 프로세스 락 ---
# 봇 이중 기동과 아카이브 동시 append 를 막는다.
# DATABASE_URL 이 없으면 파일 락으로 동작한다(같은 서버 안에서는 이것으로 충분하다).
# 락 파일 위치. 기본값은 ARCHIVE_DIR 의 상위 폴더 아래 .locks
# LOCK_DIR=/var/lib/tybot/.locks

# --- PostgreSQL (관리 콘솔 · 인덱서) ---
# 값을 넣으면 프로세스 락이 advisory 락으로 바뀌어 여러 서버에 걸친 중복 기동까지 막는다.
# 일정 스냅샷 받는 곳. 기본값은 STATE_DIR 아래 inbox-schedule.
# 추출기(scripts/schedule_export.py)의 --out 과 같은 폴더여야 한다.
# SCHEDULE_INBOX=/var/lib/tybot/inbox-schedule
#
# `/일정` 명령도 이 연결로 schedule_occurrence 를 읽는다. 없으면 그 명령은
# '준비되지 않았습니다' 로 안내한다(봇의 다른 기능에는 영향 없음).
# 스키마 적용: psql -U tybot -d tybot -f deploy/sql/console_schema.sql
# DATABASE_URL=postgresql://tybot:PASSWORD@127.0.0.1:5432/tybot

# --- 레거시 Oracle (조직·인사 읽기 전용) ---
# 그룹웨어 조직도·인사기본을 읽어오는 접속 정보. **읽기 전용 계정만 넣는다.**
# python-oracledb 는 thin 모드로 동작하므로 Instant Client 를 설치하지 않아도 된다
# (Oracle 12.1 이상에서 지원. 우리 서버는 12.1.0.2).
#
# 가져오는 것은 조직 트리와 사번·이름·이메일·소속뿐이다.
# 주민번호·연락처·주소·급여·인사평가·가족관계는 뷰 단계에서 제외한다.
#
# 방법 1) 호스트·포트 + (SID 또는 서비스명). tnsnames.ora 가 없어도 된다.
# BPROD 는 둘 다 등록돼 있어 어느 쪽으로 넣어도 붙는다. **하나만 채운다.**
# ORACLE_HOST=172.16.x.x
# ORACLE_PORT=1523
# ORACLE_SERVICE=BPROD
# ORACLE_SID=
#
# 방법 2) tnsnames.ora 의 별칭 사용. TNS_ADMIN 은 tnsnames.ora 가 든 폴더다.
# ORACLE_DSN=BPROD
# TNS_ADMIN=C:\Program Files\Oracle Client\product\19.0.0\client_1\network\admin
#
# 접속 계정 — **반드시 TYSLACK_BOT 이다.** 뷰 소유자 TYSLACK 을 여기 넣지 않는다.
# 소유자는 원본 테이블(LOGONPASSWORD 포함)을 읽을 수 있어서, 그 계정을 봇에 주면
# "필요한 컬럼만 뷰로 노출한다"는 설계가 무의미해진다.
# ORACLE_USER=TYSLACK_BOT
# ORACLE_PASSWORD=
#
# **뷰가 있는 스키마.** 원본 스키마(COVI_SMART4J)가 아니라 뷰 소유자를 적는다.
# 봇은 여기서 V_TYSLACK_ORG · V_TYSLACK_EMP 두 개만 읽는다.
# 원본 구조를 들여다볼 때만 oracle_probe.py --schema COVI_SMART4J 로 덮어쓴다.
# ORACLE_SCHEMA=TYSLACK
#
# --- 조사 전용(개발 PC에서만). 운영 서버에는 넣지 않는다 ---
# 그룹웨어 원본 테이블 구조를 들여다볼 때만 쓰는 계정.
# 이 계정(GWUSER)은 UPDATE ANY TABLE·DROP ANY TABLE·INSERT ANY TABLE 을 갖고 있다.
# 그래서 ORACLE_USER 자리에 넣지 않는다 — 봇·배치는 뷰 2개만 읽는 TYSLACK_BOT 을 쓴다.
# 새 연동 대상(예: 알림 테이블)의 구조·건수를 확인하고 나면 지운다.
# GW_PROBE_USER=GWUSER
# GW_PROBE_PASSWORD=

# --- 관리 콘솔 ---
# 콘솔 계정은 PostgreSQL console_user 테이블에서 관리하며 회사 이메일로 로그인한다.
# 계정이 없거나 DB에 연결할 수 없으면 콘솔은 기동하지 않는다.
# 세션 서명 키. 없으면 기동할 때마다 새로 만들어져 재시작 시 모두 다시 로그인해야 한다.
# 만들기: python -c "import secrets;print(secrets.token_urlsafe(32))"
# CONSOLE_SECRET=REPLACE_ME
# 워크스페이스 관리에서 Slack 토큰을 암호화할 전용 Fernet 키 파일.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WORKSPACE_SECRET_KEY_FILE=/etc/tybot/workspace-secret.key
#
# HTTPS 를 붙였으면 1 로 켠다(세션 쿠키를 암호화된 연결에서만 보낸다).
# CONSOLE_COOKIE_SECURE=0
#
# 인증 방식. password(기본) 또는 proxy.
# proxy 는 앞단 인증 프록시가 넣어 주는 X-Forwarded-Email 헤더를 믿는다.
# **프록시를 반드시 거치는 구성에서만** 쓴다. 직접 노출된 상태로 켜면 아무나 관리자가 된다.
# CONSOLE_AUTH=password
#
# 환경변수 설정 쓰기 요청을 허용할 콘솔 Origin. 같은 Host는 자동 허용한다.
# HTTPS 프록시 뒤에서 외부 주소와 내부 Host가 다를 때만 콤마로 지정한다.
# CONSOLE_ALLOWED_ORIGINS=https://tybot-console.intra.example
#
# 콘솔이 쓰는 제한 설정 오버레이. 기본값은 STATE_DIR/config/console-managed.env다.
# 보통 지정할 필요가 없으며 Slack 토큰·API 키는 이 파일에 쓰지 않는다.
# ENV_SETTINGS_PATH=/var/lib/tybot/config/console-managed.env
#
# 봇 규칙(하네싱) MD 폴더. 기본값은 ARCHIVE_DIR 의 상위 폴더 아래 harness
# HARNESS_DIR=/var/lib/tybot/harness
#
# 봇 상태 파일·락 파일을 두는 폴더. 기본값은 ARCHIVE_DIR 의 상위 폴더
# STATE_DIR=/var/lib/tybot
#
# 빌드된 콘솔 화면(dist)을 API 와 같은 프로세스에서 서빙하려면 경로를 넣는다.
# CONSOLE_DIST=/opt/tybot/console-web/dist

# --- 이후 단계(미사용) ---
# ARCHIVE_REPO=git@github.com:org/tybot-archive.git
# ARCHIVE_PULL_INTERVAL_MIN=15
# LEGACY_DB_DSN=REPLACE_ME_READONLY
