# Hermes Hub — 환경변수 예시 (실제 값은 서버 시크릿 매니저에만)
# 워크스페이스별 토큰은 서버 설정으로 주입. 아래는 자리표시자.

# Slack (워크스페이스별)
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_APP_TOKEN=xapp-REPLACE_ME

# LLM 게이트웨이
ANTHROPIC_API_KEY=REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
DEFAULT_MODEL=claude-sonnet-5
DAILY_COST_LIMIT_USD=50

# 중앙 아카이브(GitHub 비공개)
ARCHIVE_REPO=git@github.com:org/hermes-archive.git
ARCHIVE_PULL_INTERVAL_MIN=15

# 레거시(읽기전용, 내부망)
LEGACY_DB_DSN=REPLACE_ME_READONLY
