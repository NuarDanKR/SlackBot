# Hermes Hub — 환경변수 예시 (실제 값은 .env 에만, 커밋 금지)
# 파일럿: 워크스페이스 1개 + Anthropic 키 1개

# --- Slack (파일럿 워크스페이스 1개) ---
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_APP_TOKEN=xapp-REPLACE_ME

# --- LLM 게이트웨이 ---
ANTHROPIC_API_KEY=REPLACE_ME
# OPENAI_API_KEY=REPLACE_ME          # 파일럿에서는 미사용
DEFAULT_MODEL=claude-sonnet-5
DAILY_COST_LIMIT_USD=10

# --- 파일럿 설정 ---
PILOT_WORKSPACE=pilot
BOT_NAME=tybot             # Slack 봇 핸들(ASCII). 안내 메시지의 /invite 대상
ARCHIVE_DIR=./archive
LOG_LEVEL=INFO

# 질의응답 감사 기록 (아카이브와 분리 - 봇 답변이 근거로 재사용되면 안 된다)
QA_LOG_DIR=./qa-log
QA_LOG_MD=1              # 1이면 사람이 읽는 일자별 MD 도 함께 생성

# 실시간 수집: 봇이 초대된 모든 채널의 메시지를 들어오는 즉시 원문 저장
REALTIME_INGEST=1
# 전 채널 통합조회 허용자(Slack user id 콤마 구분). 채널 멤버십 필터를 우회하므로 최소 인원만.
EXEC_USERS=

# --- 이후 단계(파일럿에서는 미사용) ---
# ARCHIVE_REPO=git@github.com:org/hermes-archive.git
# ARCHIVE_PULL_INTERVAL_MIN=15
# LEGACY_DB_DSN=REPLACE_ME_READONLY
