#!/usr/bin/env bash
# 도구 무관 커밋 가드 — 사람·Claude Code·Codex·CI 어디서 커밋해도 동일하게 걸린다.
#
# 설치: git config core.hooksPath .githooks
# 우회: git commit --no-verify  (정당한 사유가 있을 때만. 이력에 남지 않으니 조심)
#
# .claude/hooks/guard.py 는 Claude Code 도구 호출만 검사한다. 다른 에이전트는 그 훅을
# 거치지 않으므로, 저장소 차원의 방어선이 별도로 필요하다.
set -uo pipefail

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[[ -z "$staged" ]] && exit 0

block() { echo "[pre-commit] 차단: $1" >&2; fail=1; }

# 1) .env 등 시크릿 파일 자체
while IFS= read -r f; do
  case "$f" in
    .env|*/.env|*.env)
      [[ "$f" == *.env.example ]] || block "$f — 시크릿 파일은 커밋하지 않는다(.env.example 만)" ;;
    */id_rsa|*/id_ed25519|*.pem|*.p12|*.pfx|*service-account*.json)
      block "$f — 개인키/자격증명 파일" ;;
  esac
done <<< "$staged"

# 2) 스테이징된 내용의 시크릿 패턴
patterns='xox[baprs]-[A-Za-z0-9]{10,}|sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
if git diff --cached -U0 | grep -nEq "^\+.*($patterns)"; then
  git diff --cached -U0 | grep -nE "^\+.*($patterns)" | head -5 >&2
  block "시크릿 패턴이 변경분에 포함됨 — 서버 시크릿 매니저로만 관리한다"
fi

# 3) PII / 아카이브 제외 대상
#
# 무엇을 막으려는 것인가 — **개인정보 데이터**다. 그것을 막는 **코드와 주석**이 아니다.
# 예전에는 둘을 구분하지 못해서, PII 탐지기 자신(`orgsync.py` 의 주민번호 정규식)과
# "이 뷰에 주민번호 컬럼이 있으면 안 된다" 는 SQL 주석까지 막았다. 그러면 사람은
# 문구를 우회해서 쓰거나 --no-verify 를 습관화한다. 둘 다 가드를 무력하게 만든다.
#
# 실제 원문이 들어오는 경로는 `archive/`·`qa-log/` 이고, 그건 4) 에서 통째로 막는다.
# 여기서는 **그 밖의 경로에 데이터가 섞여 들어오는 것**만 본다.
#
# 걸리면 반드시 위치를 출력한다. 어디서 걸렸는지 모르면 고칠 수도, 판단할 수도 없다.

# 규칙을 '설명'하거나 '구현'하는 표면. 키워드가 나오는 것이 정상인 곳이다.
KEYWORD_ALLOWED=':(exclude).githooks/*
:(exclude).claude/*
:(exclude)docs/*
:(exclude)*.md
:(exclude)console-web/src/*
:(exclude)deploy/sql/*
:(exclude)scripts/*
:(exclude)src/*
:(exclude)tests/*
:(exclude).env.example'

# 주민번호 '형식'은 실제 값일 가능성이 높아 거의 모든 곳에서 막는다.
# 예외는 tests/ 뿐이다 — PII 탐지기가 실제로 잡는지 확인하려면 형식이 필요하다.
# 대신 조용히 넘기지 않고 경고로 보여준다(진짜 값이 섞이면 사람이 알아채야 한다).
RRN_ALLOWED=':(exclude)tests/*'

rrn='[0-9]{6}\s*-\s*[1-4][0-9]{6}'
# shellcheck disable=SC2086
rrn_hits=$(git diff --cached -U0 --name-only -- . $RRN_ALLOWED | while IFS= read -r f; do
  git diff --cached -U0 -- "$f" | grep -nE "^\+.*($rrn)" | sed "s|^|  $f: |"
done)
if [[ -n "$rrn_hits" ]]; then
  echo "$rrn_hits" | head -10 >&2
  block "주민번호 형식이 변경분에 포함됨"
fi

# shellcheck disable=SC2086
rrn_in_tests=$(git diff --cached -U0 -- 'tests/*' | grep -cE "^\+.*($rrn)" || true)
if [[ "${rrn_in_tests:-0}" -gt 0 ]]; then
  echo "[pre-commit] 주의: tests/ 에 주민번호 형식 ${rrn_in_tests}건 — 가짜 값인지 확인" >&2
fi

pii_kw='주민등록번호|주민번호|등기부\s*등본|계약자\s*명단'
# shellcheck disable=SC2086
kw_hits=$(git diff --cached -U0 --name-only -- . $KEYWORD_ALLOWED | while IFS= read -r f; do
  git diff --cached -U0 -- "$f" | grep -nE "^\+.*($pii_kw)" | sed "s|^|  $f: |"
done)
if [[ -n "$kw_hits" ]]; then
  echo "$kw_hits" | head -10 >&2
  block "PII/아카이브 제외 키워드가 코드·데이터 변경분에 포함됨"
fi

# 4) 아카이브 원문·감사기록은 코드 저장소에 커밋하지 않는다
if echo "$staged" | grep -qE '^(archive|qa-log)/'; then
  block "archive/ · qa-log/ 는 사내 대화 원문·감사기록이다. 코드 저장소 금지"
fi

# 5) 테스트 (tests/ 가 있고 pytest 가 설치돼 있을 때만)
if [[ -d tests ]]; then
  if [[ -x .venv/bin/python ]]; then PY=.venv/bin/python
  elif [[ -x .venv/Scripts/python.exe ]]; then PY=.venv/Scripts/python.exe
  else PY=$(command -v python3 || command -v python || true); fi
  if [[ -n "${PY:-}" ]] && "$PY" -c "import pytest" 2>/dev/null; then
    "$PY" -m pytest -q --no-header -x >/tmp/tybot-pretest.log 2>&1
    rc=$?
    # 5 = 수집된 테스트 없음(빈 저장소). 실패로 보지 않는다.
    if [[ $rc -ne 0 && $rc -ne 5 ]]; then
      tail -20 /tmp/tybot-pretest.log >&2
      block "테스트 실패 — 커밋 전에 고친다"
    fi
  fi
fi

exit $fail
