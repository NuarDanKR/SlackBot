{
  "name": "tybot-console-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TYBot 관리 콘솔 — 워크스페이스 현황 · API 사용량 · 배포 승인",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "api": "node scripts/run-api.mjs",
    "dev:all": "npm-run-all --parallel api dev"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
