# Hermes 환경변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 루트 .gitignore 가 차단합니다)
#
#   copy .env.example .env
#
# ─────────────────────────────────────────────────────────────

# Slack 봇 토큰 — api.slack.com/apps → 내 앱 → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-

# Slack 앱 레벨 토큰 — 같은 앱 → Basic Information → App-Level Tokens
# (connections:write 스코프로 발급. Socket Mode 에 필요)
SLACK_APP_TOKEN=xapp-

# Anthropic API 키 — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-

# 자료 저장소 뿌리 — config.json·slack-export·documents 가 있는 폴더의 **절대경로**.
#
# 저장소가 둘이라 이 값이 필요합니다. 코드(이 저장소)는 팀끼리 나눠 쓰고 자료는 팀마다
# 따로인데, **config.json 이 그 자료 저장소 안에 있어서 자기 위치를 알려줄 수 없습니다**
# (순환). 그래서 여기 한 줄로만 알려줄 수 있습니다.
#
#   윈도우 예 :  C:/Users/<이름>/hermes/archive
#   리눅스 예 :  /opt/hermes/archive       (VM 은 setup.sh 가 자동으로 적습니다)
#
# **비워 두면 코드 저장소 옆의 `hermes-archive` 폴더를 찾습니다.** 그 이름으로 클론하지
# 않았으면 못 찾고, 그때 증상은 「config.json 이 없다」로만 나타납니다 — 원인이 이 줄이라는
# 것이 화면에 안 보입니다.
HERMES_DATA_ROOT=

# ─────────────────────────────────────────────────────────────
# 배포 확인(`npm run deployed`)이 쓰는 VM 값. **없어도 됩니다** —
# 그때는 그 검사가 「못 쟀습니다」라고 적고 로컬 몫(안 나간 커밋)만 잽니다.
# 세 값은 deploy/README.md 「먼저」 절의 표와 같은 것입니다.
GCP_VM=
GCP_PROJECT=
GCP_ZONE=
