#!/bin/sh
# origin/main 으로 **실제로 나갈 커밋 목록**을 찍고, 그 목록을 승인 기록에 적는다.
#
#     sh .githooks/push-approve
#
# **이 폴더를 공유하는 저장소에서는 그 경로가 없다** — 자료 저장소가 `core.hooksPath` 로
# 여기를 가리킨다. 거기서는 아래로 친다 (`pre-push` 가 막을 때 찍어 주는 것도 이것이다).
#
#     sh "$(git rev-parse --git-path hooks)/push-approve"
#
# 이 출력이 곧 WHK에게 보여드릴 화면이다. 승인을 받은 **다음 턴**에 `git push` 한다.
#
# ── 왜 이 명령이 필요한가 ──
#
# 2026-08-05 와 08-06 에 승인 안 받은 커밋이 함께 나갔다. 두 번 다 확인한 것은
# `git status` 였는데 **그건 작업 트리만 본다** — 이미 커밋됐지만 아직 push 안 된
# 남의 커밋은 거기 안 보이고, `git push` 는 브랜치 전체를 올린다.
# 그래서 「깨끗하다」를 보고 push 했고 8/5 에는 2개, 8/6 에는 4개가 나갔다.
#
# ── 먼저 fetch 하고, 실패하면 멈춘다 ──
#
# `origin/main` 이 낡아 있으면 여기서 찍는 목록이 **실제로 나갈 것보다 짧다.**
# 낡은 목록을 승인받는 것은 이 관문이 막으려던 바로 그 사고라, 조용히 넘어가지 않는다.
# (fetch 가 안 되는 상황이면 어차피 push 도 안 된다.)
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" != "main" ]; then
  echo "push 관문은 main 에만 걸려 있습니다 (WHK 결정 2026-08-29)." >&2
  echo "  지금 브랜치는 '$BRANCH' 라 승인 기록 없이 push 됩니다." >&2
  exit 1
fi

# ── 원격에 main 이 아직 없으면 「첫 push」다 (2026-08-31) ──
#
# 새로 만든 빈 저장소에는 `main` 이 없어서 `git fetch origin main` 이 실패한다.
# 그전에는 그것을 「원격을 못 읽었다」로 읽고 멈췄고, 그러면 승인 기록을 만들 길이
# 없어 **첫 push 만 관문 밖**으로 나가게 돼 있었다. 하필 그날이 이력 전부가 한 번에
# 나가는 날이다 — 자료 저장소면 회사 자료 전부다.
#
# 「없다」와 「못 읽었다」는 갈라야 한다. `ls-remote` 는 ref 가 없으면 **종료 0 에 빈
# 출력**이고, 네트워크·인증이 안 되면 **종료가 0 이 아니다.** fetch 로는 그 둘이
# 똑같이 실패로 보여서 가를 수 없었다.
if ! LSR=$(git ls-remote --heads origin main 2>&1); then
  echo "origin 을 읽지 못해 멈춥니다 — 낡은 목록을 승인받으면 안 됩니다." >&2
  echo "  $LSR" >&2
  echo "  네트워크를 확인하고 다시 하세요. (읽지 못한 것은 「나갈 것이 없다」가 아닙니다)" >&2
  exit 1
fi

if [ -z "$LSR" ]; then
  OUTGOING=$(git rev-list HEAD)
  N=$(printf '%s\n' "$OUTGOING" | wc -l | tr -d ' ')
  echo "origin/main 이 아직 없습니다 — **첫 push 라 이력 ${N}건이 통째로 나갑니다.**"
  echo ""
  echo "  가장 오래된 것 3개:"
  git log --oneline --no-decorate --reverse HEAD | head -3 | sed 's/^/    /'
  echo "  가장 새 것 3개:"
  git log --oneline --no-decorate HEAD | head -3 | sed 's/^/    /'
  echo ""
  echo "  추적 파일 $(git ls-files | wc -l | tr -d ' ')개 · $(git rev-list --count HEAD)건의 커밋"
  echo ""
  echo "**첫 push 는 목록을 훑어 고르는 자리가 아닙니다** — 저장소에 든 이력 전부가"
  echo "그대로 원격에 남습니다. 지운 파일도 이력 안에 남아 있습니다."
  echo ""
  printf '%s\n' "$OUTGOING" >"$(git rev-parse --git-dir)/push-approved"
  echo "적었습니다. 이 목록 그대로일 때만 push 가 통과합니다 — 하나라도 늘거나 줄면 막힙니다."
  exit 0
fi

if ! git fetch -q origin main; then
  echo "origin 을 읽지 못해 멈춥니다 — 낡은 목록을 승인받으면 안 됩니다." >&2
  echo "  네트워크를 확인하고 다시 하세요. (읽지 못한 것은 「나갈 것이 없다」가 아닙니다)" >&2
  exit 1
fi

if ! git rev-parse --verify -q FETCH_HEAD >/dev/null; then
  echo "origin/main 을 찾지 못해 멈춥니다." >&2
  exit 1
fi

# ── 뒤처졌으면 먼저 멈춘다 (2026-08-30) ──
#
# fetch 는 이미 했으니 자료는 손에 있는데, 전에는 `FETCH_HEAD..HEAD`(나갈 것) **한 방향만**
# 세고 `HEAD..FETCH_HEAD`(들어와야 할 것)를 안 물었다. 그래서 원격이 앞서 있어도
# 「이 목록 그대로일 때만 통과합니다」라고 적었고, 정작 push 는 `non-fast-forward` 로
# 거절됐다 — **성공할 수 없다는 것을 알 수 있었는데 안 알려준 것이다.**
#
# 내 커밋이 0건일 때가 더 나빴다: `OUTGOING` 이 비어 「origin/main 과 같습니다」로 빠져
# **같다고 단정**했다. 원격이 앞서 있는데 같다고 말하는 것이다.
#
# 같은 저장소의 `archive-run/scripts/board.py` 는 처음부터 양방향을 센다 — 이 명령만
# 그 패턴을 안 따랐다.
BEHIND=$(git rev-list --count HEAD..FETCH_HEAD)
if [ "$BEHIND" != 0 ]; then
  echo "origin 이 ${BEHIND}개 앞서 있어 멈춥니다 — 지금 push 하면 거절됩니다." >&2
  echo "" >&2
  echo "  들여와야 할 커밋:" >&2
  git log --oneline --no-decorate HEAD..FETCH_HEAD | sed 's/^/    /' >&2
  echo "" >&2
  echo "  먼저 들여오세요: git merge FETCH_HEAD   (또는 git pull origin main)" >&2
  echo "  들여오면 나갈 목록이 달라집니다 — 이 명령을 **다시** 돌려 승인받으세요." >&2
  exit 1
fi

OUTGOING=$(git rev-list FETCH_HEAD..HEAD)

if [ -z "$OUTGOING" ]; then
  echo "내보낼 커밋이 없습니다 — origin/main 과 같습니다."
  exit 0
fi

N=$(printf '%s\n' "$OUTGOING" | wc -l | tr -d ' ')

echo "origin/main 으로 나갈 커밋 ${N}개 (오래된 것부터):"
echo ""
git log --oneline --no-decorate --reverse FETCH_HEAD..HEAD | sed 's/^/  /'
echo ""
echo "  전체 변경 —$(git diff --shortstat FETCH_HEAD..HEAD)"
echo ""
echo "**이 목록에 내가 만들지 않은 커밋이 있는지 보세요.**"
echo "다른 창의 세션이 커밋만 하고 push 를 안 했으면 그것도 여기 섞여 있고, 함께 나갑니다."
echo ""

printf '%s\n' "$OUTGOING" >"$(git rev-parse --git-dir)/push-approved"

echo "적었습니다. 이 목록 그대로일 때만 push 가 통과합니다 — 하나라도 늘거나 줄면 막힙니다."
