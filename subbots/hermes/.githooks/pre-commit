# ── 여섯째: 스테이징된 **파일 본문**에 사업장·비공개 채널 이름이 들었나 (2026-09-06) ──
#
# `check-business-names.js` 의 파일 훑기는 **`npm run check` 에서만 돌았다.** 커밋 관문은
# `commit-msg` 가 **메시지만** 봤다. 그래서 파일 본문에 이름을 쓴 커밋은 아무것도 안 막았다.
#
# 2026-09-06 에 실제로 뚫렸다 — 스킬 문서 본문에 비공개 채널 이름을 적었는데, 잡아 준 것은
# 이 검사가 아니라 **커밋 메시지 쪽에 같은 이름이 우연히 함께 들어간 것**뿐이었다.
# 메시지에만 안 썼으면 그대로 커밋되고 push 됐다.
#
# 대는 것은 **인덱스**다 (위 셋째·넷째·다섯째와 같은 규칙). 그리고 `commit-msg` 와 같은
# 이유로 **훅이 사는 저장소와 커밋하는 저장소가 같을 때만** 잰다 — 자료 저장소는 배포용이
# 아니고 사업장 이름이 자료 그 자체라, 그대로 두면 정당한 커밋이 전부 막힌다.
HOOK_REPO_N="$(git -C "$CODE_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
COMMITTING_IN_N="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$HOOK_REPO_N" ]; then
  echo "" >&2
  echo "커밋을 멈춥니다 — 훅이 사는 곳이 git 저장소가 아니라 이름 검사를 **재지 못했습니다** ($CODE_ROOT)" >&2
  fail=1
elif [ -n "$COMMITTING_IN_N" ] && [ "$COMMITTING_IN_N" != "$HOOK_REPO_N" ]; then
  echo "  - 파일 본문 이름 검사: 이 저장소는 배포용이 아니라 해당 없습니다 (훅은 $HOOK_REPO_N 것)"
else
  NODE_N=$(command -v node || command -v node.exe)
  CHECK_N="$CODE_ROOT/scripts/check-business-names.js"
  if [ ! -f "$CHECK_N" ]; then
    # 관문 스크립트가 없는 저장소에서는 아무것도 안 하고 통과한다 — 스킬을 일부만 가져간
    # 곳에서 남의 커밋을 전부 막지 않으려는 것이다 (위 관문들과 같은 규칙).
    :
  elif [ -z "$NODE_N" ]; then
    echo "" >&2
    echo "커밋을 멈춥니다 — node 를 찾지 못해 파일 본문 이름 검사를 못 돌렸습니다." >&2
    echo "  재지 못한 것은 「이름이 없다」가 아닙니다." >&2
    echo "  손으로 돌리려면: node \"$CHECK_N\" --스테이징" >&2
    fail=1
  else
    "$NODE_N" "$CHECK_N" --스테이징 || fail=1
  fi
fi

exit $fail
