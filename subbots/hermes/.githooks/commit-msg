#!/usr/bin/env bash
#
# 커밋 메시지에 사업장·비공개 채널 이름이 들어가는 것을 막는다.
#
# **왜 있나** — 이 저장소는 **배포용**이다. 코드·스킬·배포 절차를 다른 팀에 그대로
# 넘기므로 우리 사업장 이름이 들어가면 안 된다. `check-business-names.js` 가 그것을
# 막고 있었는데, **그 검사는 파일만 본다.** 커밋 메시지는 어느 관문도 안 봤다.
#
# 2026-09-03 에 실제로 났다 — 코드에는 이름을 안 넣었는데 커밋 메시지 한 줄에 채널
# 이름이 들어갔다. push 전에 발견해 이력을 다시 썼지만, **push 했으면 팀이 보는
# 이력에 영구히 남았다.** 메시지는 파일이 아니라서 아무 검사에도 안 걸리는 자리였다.
#
# ── 다른 배포용 저장소에 옮길 때 ──
#
# 이 훅과 `scripts/check-business-names.js` 를 함께 가져가면 된다. 이름은 그 팀의
# 자료 저장소(`HERMES_DATA_ROOT`)에서 만들어지므로 **옮긴 곳에서는 그 팀 이름을 막는다** —
# 목록을 새로 적을 것이 없다. `git config core.hooksPath .githooks` 가 걸려 있어야 돈다.
#
# **자료 저장소에는 걸지 마라.** 거기는 사업장 이름이 자료 그 자체다.
#
# ── 조용히 통과하지 않는다 ──
#
# 검사 스크립트가 없거나 node 가 없으면 **막는다.** 이 저장소가 여러 번 배운 것이다 —
# 「재지 못했다」를 「이상 없다」로 내면 그 관문은 있으나 마나다. 종료코드 0 으로
# 빠져나가는 갈래는 검사가 실제로 돌아서 통과한 경우 하나뿐이다.

set -euo pipefail

MSG_FILE="${1:-}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHECK="$ROOT/scripts/check-business-names.js"

if [ -z "$MSG_FILE" ]; then
  echo "commit-msg: 메시지 파일 경로를 못 받았습니다 — 훅이 잘못 불렸습니다." >&2
  exit 1
fi

# ── 배포용 저장소에서만 잰다 ──────────────────────────────────────────────
#
# **자료 저장소가 이 폴더를 그대로 쓴다** — `core.hooksPath` 가
# `<코드저장소>/.githooks` 를 가리키게 돼 있어서(7.5 관문이 그렇게 돈다) 이 훅도 거기서
# 함께 불린다. 그런데 자료 저장소는 배포용이 아니고 **사업장 이름이 자료 그 자체**라,
# 그대로 두면 「채널 셋을 고친다」 같은 정당한 커밋이 막힌다.
# 2026-09-03 에 만들자마자 그 일이 났다.
#
# 그래서 **훅이 사는 저장소와 지금 커밋하는 저장소가 같을 때만** 잰다. 새 배포용 저장소는
# 이 훅을 자기 `.githooks/` 로 가져가므로 거기서는 같아지고, 그 팀 이름을 막는다.
# 조용히 넘어가지 않고 **왜 안 재는지 화면에 적는다** — 안 적으면 다음 사람이 이 저장소도
# 지켜지고 있다고 읽는다.
# **양쪽 다 git 에게 물어서 댄다.** 한쪽을 셸의 `pwd` 로 만들면 안 된다 — 윈도우에서
# git 은 `C:/Users/…` 를 주고 Git Bash 의 `pwd` 는 `/c/Users/…` 를 줘서 **같은 폴더인데
# 문자열이 안 맞는다.** 2026-09-03 에 그렇게 만들었다가 배포용 저장소 자신에서 검사가
# 통째로 꺼졌다(화면에 「해당 없습니다」를 찍으며 통과했다). 형식을 맞추려 하지 말고
# 같은 도구가 만든 값끼리 댄다.
HOOK_REPO="$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
COMMITTING_IN="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$HOOK_REPO" ]; then
  echo "commit-msg: 훅이 사는 곳이 git 저장소가 아니라 **재지 못했습니다** ($ROOT)" >&2
  exit 1
fi
if [ -n "$COMMITTING_IN" ] && [ "$COMMITTING_IN" != "$HOOK_REPO" ]; then
  echo "  - 커밋 메시지 이름 검사: 이 저장소는 배포용이 아니라 해당 없습니다 (훅은 $HOOK_REPO 것)"
  exit 0
fi

if [ ! -f "$CHECK" ]; then
  echo "commit-msg: $CHECK 가 없어 **재지 못했습니다.**" >&2
  echo "  재지 못한 것은 「이름이 없다」가 아닙니다. 파일을 되살리고 다시 커밋하세요." >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "commit-msg: node 를 찾지 못해 **재지 못했습니다.**" >&2
  echo "  이 저장소는 node 가 하드 전제입니다 (npm run doctor)." >&2
  exit 1
fi

node "$CHECK" --메시지 "$MSG_FILE"
