#!/bin/sh
# push 관문 — **승인받은 목록 그대로일 때만** origin/main 으로 내보낸다.
#
# ── 무엇이 났나 ──
#
# 2026-08-05: 다른 세션이 `811476c`(문서 아카이브 9건, 14:44)를 커밋만 하고 push 는
# 안 한 상태에서 이 세션의 `0932ab5` 가 그 위에 쌓였고, `git push` 한 번에 **둘 다**
# 나갔다. git 은 브랜치 끝만 밀기 때문에 아래 커밋을 골라 남길 수 없다.
# 2026-08-06: 승인받은 3개를 push 했는데 전날 밤 커밋 하나가 원격에 없어 4개가 나갔다.
#
# 두 번 다 확인한 것은 `git status` 였다. **그건 작업 트리만 본다** — 이미 커밋됐지만
# 아직 push 안 된 남의 커밋은 거기 안 보인다. push 는 되돌릴 수 없고, 나간 내용은
# 15분 안에 VM 이 pull 해 봇이 팀 앞에서 인용하는 근거가 된다.
#
# ── 왜 「내 커밋인가」로 판정하지 않나 ──
#
# 커밋에 임자를 적는 길이 지금은 없다. 2026-08-29 실측으로 최근 커밋 100개 중
# `Claude-Session` 트레일러가 든 것은 **32개뿐**이다(`Co-Authored-By` 는 78개).
# 나머지 68개는 어느 세션이 만들었는지 커밋 안에 안 적혀 있어서, 임자로 판정하면
# 그 68개를 전부 남의 것으로 읽거나 전부 내 것으로 읽는다. 둘 다 틀린다.
#
# 그래서 임자 대신 **「승인받은 목록과 같은가」**로 판정한다. `doc-archive` 7.5
# 점검표가 표를 낼 때 md 해시를 남기고 `pre-commit` 이 기록에 없는 것을 찾아 멈추는
# 것과 같은 구조다.
#
# ── 정한 것 ──
#
# **`main` 에만 건다** (WHK 결정 2026-08-29). 사고가 난 자리가 main 이고, VM 이 pull 해
# 봇의 근거로 쓰는 것도 main 뿐이다. 작업 브랜치(`sdd/*`)까지 막으면 안 나가는 것을
# 막는 셈이라 우회가 습관이 되고, 그러면 장치가 죽는다.
#
# **기록은 `.git/` 안에 둔다.** 작업 트리에 두면 `.gitignore` 를 빠뜨렸을 때 승인
# 기록이 저장소에 실려 나간다. `git rev-parse --git-dir` 을 쓰므로 **워크트리마다
# 따로 갈린다** — 워크트리의 승인이 본 저장소의 push 를 통과시키지 않는다.
#
# **통과해도 기록을 안 지운다.** 지우면 push 가 네트워크로 실패했을 때 승인부터 다시
# 받아야 한다. 남겨도 위험하지 않다 — 남는 기록으로 통과하는 경우는 **같은 것을 다시
# 보내는 때**뿐이고, 하나라도 늘거나 줄면 목록이 달라져 막힌다.
#
# ── 이 관문이 못 막는 것 ──
#
# 막을 수 있는 선은 「목록이 출력됐고 그 목록 그대로 나간다」까지다.
# **「사람이 그 목록을 봤다」는 여전히 승인 규칙이 맡는다.**
#
# 그리고 **다른 두 형태는 하나도 안 막힌다** — ① 내 미커밋 변경이 남의 커밋에 담겨
# 나가는 것(2026-08-04, 204건) ② 남이 같은 파일을 만지다 내 미커밋 줄까지 담아 push 한
# 것(2026-08-05 `e38008e`). 둘 다 작업 트리가 하나라서 나는 일이고, git 은 작업 트리의
# 변경에 임자를 기록하지 않아 훅이 판정할 근거가 없다. 근본은 세션마다 워크트리를
# 가르는 것이다 — `active-todos.md` 105행.
#
# ── VM 은 영향받지 않는다 ──
#
# Hermes VM 은 `core.hooksPath` 를 안 걸어 두므로(의도한 것) 자동 반영 push 는 그대로
# 돈다. 이 파일이 저장소에 들어가도 VM 에서는 안 돈다.
#
# ── 시험 ──
#
#     sh .githooks/test-push-gate.sh
#
# **손으로 안 쳐도 돈다** (2026-08-31 부터). 이 파일이나 `push-approve`·시험 자신이
# 커밋에 담기면 `pre-commit` 이 그 시험을 돌리고, 실패하면 커밋을 막는다. 그전에는
# 이 주석 한 줄이 부르는 법의 전부라 파일이 있다는 것을 아는 사람만 돌렸다.
# 시험은 **인덱스에서 꺼낸 판**을 보므로, 작업 트리에서 고쳤으면 `git add` 를 다시 한다.

cd "$(git rev-parse --show-toplevel)" || exit 1

APPROVED="$(git rev-parse --git-dir)/push-approved"
ZERO=0000000000000000000000000000000000000000

fail=0

# stdin 으로 `<로컬ref> <로컬sha> <원격ref> <원격sha>` 가 줄마다 온다.
# **안쪽 git 호출은 전부 `</dev/null`** — 안 그러면 이 목록을 삼켜 뒷줄이 사라진다.
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue  # 브랜치 삭제 push

  if [ "$remote_sha" = "$ZERO" ]; then
    outgoing=$(git rev-list "$local_sha" </dev/null)
  else
    outgoing=$(git rev-list "$remote_sha..$local_sha" </dev/null)
  fi
  [ -n "$outgoing" ] || continue

  if [ -f "$APPROVED" ]; then
    approved=$(cat "$APPROVED")
  else
    approved=""
  fi

  [ "$outgoing" = "$approved" ] && continue

  # ── 여기서부터 막는다. 무엇이 어긋났는지를 **커밋 이름으로** 말한다 ──
  #
  # 「목록이 다릅니다」로는 사람이 아무것도 못 한다. 늘어난 것이 남의 커밋인지
  # 내가 방금 만든 것인지는 제목을 봐야 안다.
  echo "" >&2
  echo "push 를 멈춥니다 — 나갈 커밋이 승인받은 목록과 다릅니다." >&2
  echo "" >&2

  if [ -z "$approved" ]; then
    if [ "$remote_sha" = "$ZERO" ]; then
      # 첫 push — 원격에 main 이 없어 `$remote_sha..$local_sha` 라는 범위가 성립하지
      # 않는다. 전에는 그 범위로 `git log` 를 불러 `Invalid revision range` 로 죽고
      # 아래의 `2>/dev/null` 이 그것을 지워 **목록이 한 줄도 안 찍혔다** (2026-09-02
      # 발견). 같은 상황을 `push-approve` 는 「첫 push 라 이력 N건이 통째로
      # 나갑니다」로 다루므로 그 갈래를 따른다 — 전부 찍는 대신 규모와 양 끝을 보인다.
      n=$(git rev-list --count "$local_sha" </dev/null)
      echo "  승인 기록이 없습니다. **첫 push 라 이력 ${n}건이 통째로 나갑니다:**" >&2
      echo "  가장 오래된 것 3개:" >&2
      git log --oneline --no-decorate --reverse "$local_sha" </dev/null | head -3 | sed 's/^/    /' >&2
      echo "  가장 새 것 3개:" >&2
      git log --oneline --no-decorate "$local_sha" </dev/null | head -3 | sed 's/^/    /' >&2
    else
      echo "  승인 기록이 없습니다. 이 push 로 나갈 커밋:" >&2
      git log --oneline --no-decorate --reverse "$remote_sha..$local_sha" </dev/null 2>/dev/null |
        sed 's/^/    /' >&2
    fi
  else
    TMPA=$(mktemp) || exit 1
    TMPO=$(mktemp) || { rm -f "$TMPA"; exit 1; }
    printf '%s\n' "$approved" >"$TMPA"
    printf '%s\n' "$outgoing" >"$TMPO"

    extra=$(grep -vxF -f "$TMPA" "$TMPO")
    gone=$(grep -vxF -f "$TMPO" "$TMPA")
    rm -f "$TMPA" "$TMPO"

    if [ -n "$extra" ]; then
      echo "  승인받을 때 없던 커밋:" >&2
      for c in $extra; do
        echo "    + $(git log --oneline --no-decorate -1 "$c" </dev/null 2>/dev/null)" >&2
      done
      echo "" >&2
      echo "  **이것이 다른 창의 세션이 만든 것이면 함께 나갑니다.**" >&2
    fi
    if [ -n "$gone" ]; then
      # ── 「기록에는 있는데 나갈 목록에 없다」는 두 사정이 같은 모양으로 온다 ──
      #
      # ① 다른 세션이 승인받아 **이미 push 까지 마친 것** — 커밋은 원격에 멀쩡히
      #    있고 낡은 것은 승인 기록이다 (2026-09-02 실물: `4fac5a6`·`bc55d7a`)
      # ② amend·rebase 로 바뀐 것
      # 전에는 전부 ② 라고 불러서 사람이 「내가 amend 했나」로 reflog 같은 엉뚱한
      # 곳을 봤다. `git cat-file -e` 로는 못 가른다 — amend 로 밀려난 커밋도 reflog
      # 가 잡아 객체로는 남는다. **원격 끝의 조상인가**로 가른다. ① 은 위와 같은
      # 이유(커밋 이름으로 말한다)로 제목까지 찍는다 — 원격에 있으니 찍을 수 있다.
      merged=""
      rewritten=""
      for c in $gone; do
        if [ "$remote_sha" != "$ZERO" ] &&
           git merge-base --is-ancestor "$c" "$remote_sha" </dev/null 2>/dev/null; then
          merged="$merged $c"
        else
          rewritten="$rewritten $c"
        fi
      done
      if [ -n "$merged" ]; then
        echo "  승인받았는데 이미 원격에 들어간 커밋 — 승인 기록이 낡았습니다 (다른 세션이 push 한 것일 수 있습니다):" >&2
        for c in $merged; do
          echo "    - $(git log --oneline --no-decorate -1 "$c" </dev/null 2>/dev/null)" >&2
        done
      fi
      if [ -n "$rewritten" ]; then
        echo "  승인받았는데 지금은 없는 커밋 (amend·rebase 로 바뀐 것):" >&2
        for c in $rewritten; do
          echo "    - $c" >&2
        done
      fi
    fi
  fi

  echo "" >&2
  # **경로를 글자로 박지 않는다** — 이 훅은 `core.hooksPath` 로 **다른 저장소도 함께 쓴다**
  # (자료 저장소가 코드 저장소의 이 폴더를 가리킨다). 거기서는 `.githooks/` 가 없어서
  # 안내대로 치면 「그런 파일이 없습니다」가 난다. 2026-09-03 에 실제로 겪었다.
  # `--git-path hooks` 는 `core.hooksPath` 를 따라가므로 어느 저장소에서든 맞는 경로를 준다.
  echo "  나갈 목록을 다시 보고 승인받으려면: sh \"$(git rev-parse --git-path hooks </dev/null)/push-approve\"" >&2
  echo "  그 출력을 WHK에게 보이고, 승인받은 **다음 턴**에 push 하세요." >&2
  echo "  이 검사를 뺄 것이면 git config --unset core.hooksPath 하세요." >&2
  fail=1
done

exit $fail
