# 공유 Hermes 전문봇 RPC worker — 여러 workspace 를 한 프로세스가 받는다.
#
#   systemctl start hermes-rpc-shared
#
# 인계: docs/verification/2026-10-12-hermes-shared-rpc-handoff.md
# 회신: docs/verification/2026-10-12-hermes-shared-rpc-handback.md
# 계약: docs/design/specialist-v3-tool-contract.md (스키마는 v3 그대로다)
#
# ── 템플릿이 아니다 ────────────────────────────────────────────────────────
#
# `hermes-rpc@.service` 는 **인스턴스마다 하나**이고 이 unit 은 **전체에 하나**다.
# 그래서 `%i` 가 없다. 받을 workspace 는 `profiles.json` 이 정한다.
#
# 개별 worker 는 **그대로 둔다.** OS 수준 격리가 필요한 workspace 는
# `hermes-rpc@<ws>.service` 를 계속 쓴다 — 이 unit 이 그것을 대체하지 않는다.
#
# ── 신뢰 경계가 넓어진다 ──────────────────────────────────────────────────
#
# 한 프로세스가 여러 workspace 의 API 키를 메모리에 들고 있다. 그 프로세스가 새면
# **전부** 샌다. 장애도 같다 — 재시작 한 번이 공유 대상 전체를 끊는다.
# 그래서 TYIT 를 먼저 공유 경로로 검증하고 순차로 넓힌다(인계 §재시작).
#
# ── 설치 전제 (unit 이 만들지 않는다) ─────────────────────────────────────
#
#   useradd --system --home-dir /nonexistent --shell /sbin/nologin \
#           --groups tybot-specialist-rpc hermes-rpc-shared
#   install -d -o root -g hermes-rpc-shared -m 0750 /etc/hermes-rpc-shared
#   install -d -o root -g hermes-rpc-shared -m 0750 /etc/hermes-rpc-shared/keys
#
#   # HMAC — TYBot 쪽 $TYBOT_SPECIALIST_V3_HMAC_DIR/hermes-shared.hmac 과 **같은 값**.
#   # 개별 worker 의 비밀을 복사하지 않는다(인계 §4). 공유 전용으로 새로 만든다.
#   install -o root -g hermes-rpc-shared -m 0640 /dev/null /etc/hermes-rpc-shared/hmac
#
#   # workspace 명부와 workspace 별 API 키 파일
#   install -o root -g hermes-rpc-shared -m 0640 /dev/null /etc/hermes-rpc-shared/profiles.json
#   install -o root -g hermes-rpc-shared -m 0640 /dev/null /etc/hermes-rpc-shared/keys/tyit
#
# **systemd 는 계정을 만들지 않는다.** 없으면 exec 이 217/USER 로 죽는다.

[Unit]
Description=Hermes v3 전문봇 RPC worker (공유)
Documentation=file:///opt/tybot/docs/design/specialist-v3-tool-contract.md
After=network-online.target
# TYBot 이 도구 소켓을 들고 있다. 먼저 떠 있어야 첫 질문이 안 샌다 —
# 다만 Requires 는 아니다: TYBot 재시작이 worker 를 같이 죽이면 회복이 두 배로 느려진다.
After=tybot.service
Wants=tybot.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=hermes-rpc-shared
Group=hermes-rpc-shared
# **이 그룹 하나만** 더한다. TYBot 기본 그룹에 넣으면 도구 소켓과 함께
# 아카이브 파일 권한까지 따라오고, 그러면 자료가 도구 말고 다른 문으로도 들어온다.
SupplementaryGroups=tybot-specialist-rpc
WorkingDirectory=/opt/tybot/subbots/hermes

# 자기 소켓 자리. systemd 가 만들고 종료할 때 치운다.
RuntimeDirectory=tybot-subbots/hermes-shared
# systemd 239는 ExecStartPre 뒤 RuntimeDirectory 소유권을 다시 적용한다. worker가
# TYBot 도구 소켓의 GID를 기준으로 디렉터리와 응답 소켓 그룹을 명시적으로 맞춘다.
# RestrictSUIDSGID=true를 유지하므로 SGID 비트에는 의존하지 않는다.
RuntimeDirectoryMode=0750

# Rocky 8의 systemd 239에는 LoadCredential=이 없다. 비밀 값은 여전히 환경변수에
# 넣지 않고, worker만 읽을 수 있는 파일의 **경로만** 고정한다.
Environment=HERMES_RPC_HMAC_FILE=/etc/hermes-rpc-shared/hmac
# 받을 workspace 와 각자의 domain·모델·키 파일. **허용 목록은 서버 쪽에 있다** —
# 요청 본문이 고르게 두면 요청 하나로 남의 키를 쓰게 할 수 있다(인계 §6).
Environment=HERMES_RPC_PROFILES_FILE=/etc/hermes-rpc-shared/profiles.json

# 동시 상한·버전 같은 운영 값. **비밀은 여기 두지 않는다.**
EnvironmentFile=/etc/hermes-rpc-shared/rpc.env
# 아래 둘은 unit 이 **고정한다** — env 파일 오타로 모드가 바뀌면 원문 쓰기와 독립
# Slack 역할이 열린 채로 RPC 가 돈다. 열린 것은 원문이 늘어난 뒤에야 안다.
Environment=HERMES_MODE=tybot
Environment=LANG=C.UTF-8

# ConditionPathExists 를 쓰지 않는다. 조건이 틀리면 systemd 는 유닛을 **건너뛰고
# `systemctl start` 는 0 을 반환한다** — worker 가 조용히 없는 상태가 된다.
ExecStartPre=/usr/bin/test -f /etc/hermes-rpc-shared/rpc.env
ExecStartPre=/usr/bin/test -f /etc/hermes-rpc-shared/profiles.json
ExecStartPre=/usr/bin/test -S /run/tybot/specialist-tools.sock
ExecStart=/usr/bin/node scripts/run-rpc-shared.js

Restart=on-failure
RestartSec=15
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-rpc-shared

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# 모델 호출(HTTPS)과 두 Unix socket 만 쓴다.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# worker 는 **아무것도 안 쓴다.** 상태도 로그도 journal 로만 나간다.
ReadOnlyPaths=/opt/tybot/subbots/hermes /etc/hermes-rpc-shared
# 자료 저장소를 아예 안 보이게 한다. 코드가 안 읽는 것은 시험이 재지만
# (check-rpc-isolation), 커널에서도 막아 두면 나중에 누가 한 줄 더해도 거기서 멈춘다.
InaccessiblePaths=-/var/lib/tybot/archive -/var/lib/tybot/archiver-shadow -/var/lib/tybot/state -/var/lib/hermes-pf
# **개별 worker 의 설정·비밀을 못 읽게 한다.** 공유 프로세스가 개별 인스턴스의
# HMAC 까지 들고 있으면, 공유를 쓰지 않기로 한 workspace 의 격리가 같이 무너진다.
InaccessiblePaths=-/var/lib/tybot/specialist-secrets

# ── 남는 위험 둘 (가리지 않고 적는다) ─────────────────────────────────────
#
# ① **한 프로세스가 여러 키를 든다.** 공유 실행의 전제이고 설정으로 못 줄인다.
#    줄이려면 그 workspace 를 명부에서 빼고 개별 worker 로 돌린다.
#
# ② **다른 worker 의 소켓에는 닿을 수 있다.** `/run/tybot-subbots/` 아래 형제
#    디렉터리를 `InaccessiblePaths` 로 가리면 자기 RuntimeDirectory 까지 함께
#    가려지므로 못 막는다. 닿아도 HMAC 이 달라 전부 401 이고 workspace 도 대조한다 —
#    남는 것은 로컬 DoS 이며 자료는 안 샌다.

# 공유 프로세스는 여러 요청이 동시에 돈다. 개별 worker 보다 넉넉히 둔다 —
# 모자라면 OOM 으로 죽고, 그 죽음은 **공유 대상 전체**를 끊는다.
MemoryMax=3G
TasksMax=128

# **기본은 꺼져 있다.** `[Install]` 이 있어도 저절로 켜지지 않는다. 켜는 것은
# `systemctl enable` 한 줄이고, 그 전에 계정·비밀·명부를 사람이 확인한다.
# 설치 helper(`deploy/install-rpc-shared.sh`)도 enable 도 start 도 하지 않는다.
[Install]
WantedBy=multi-user.target
