[Unit]
Description=Hermes 자료 저장소 동기화 (git pull)
Documentation=file:///opt/hermes/code/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes/archive

# 받는 곳은 자료 저장소뿐이다. 코드 저장소는 사람이 배포할 때만 pull 한다.
# --ff-only: 되감기가 필요한 상황이면 조용히 덮지 말고 실패시켜 사람이 보게 한다.
# (자료 쪽 deploy key 는 쓰기 권한이 있다 — 자동 반영이 push 하기 때문이다.)
ExecStart=/usr/bin/git pull --ff-only --quiet

# 아카이브 md 는 mtime 으로 다시 읽히므로 봇 재시작이 필요 없다(archive.js readCached).
# 다만 config.json 이 바뀐 경우는 재시작해야 반영된다:  systemctl restart hermes
# 소스는 이 타이머가 안 받아온다:  git -C /opt/hermes/code pull && systemctl restart hermes
SyslogIdentifier=hermes-pull

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hermes
