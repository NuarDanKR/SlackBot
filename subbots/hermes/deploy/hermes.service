[Unit]
Description=Hermes — 팀 슬랙 아카이브 에이전트
Documentation=file:///opt/hermes/code/README.md
# 네트워크가 올라온 뒤에 시작한다. Socket Mode 라 슬랙으로 나가는 연결이 필요하다.
After=network-online.target
Wants=network-online.target

# 5분 안에 5번 넘게 죽으면 멈춘다 — 설정 오류로 무한 재시작하며 API 를 두드리는 것을 막는다.
# **[Service] 가 아니라 여기여야 한다.** systemd 는 StartLimitIntervalSec·StartLimitBurst 를
# [Unit] 절에서만 읽는다 — [Service] 에 두면 "Service 관련 설정이니 Service 절에" 처럼
# 보이지만 `Unknown key … in section [Service], ignoring` 경고만 남기고 무시되어, 실제로는
# systemd 기본값(10초에 5번)이 적용된다. 그러면 이 창이 훨씬 좁아져 진짜 목적(설정 오류로
# 무한 재시작하며 API 를 두드리는 것을 막는 것)이 안 지켜진다. 되돌리면 scripts/check-service-unit.js 가 잡는다.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes/code
ExecStart=/usr/bin/node src/index.js

# 죽으면 무조건 되살린다. 슬랙 연결이 끊기거나 예기치 못한 예외로 종료돼도 마찬가지.
Restart=always
RestartSec=10

# 로그는 journald 로. 조회: journalctl -u hermes -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes

# 대외비 아카이브와 토큰을 다루므로 권한을 좁힌다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hermes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
